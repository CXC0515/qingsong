{
  "name": "qingsong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "server": "node node_modules/tsx/dist/cli.mjs server/index.ts",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:classroom-tasks": "node --import tsx --test src/domain/classroomTasks.test.ts server/repositories/classroomTaskRepository.test.ts server/services/classroom/classroomTaskService.test.ts server/routes/classroomTasks.test.ts server/services/classroom/classroomBehaviorService.test.ts",
    "test:roster": "node --import tsx --test server/database/rosterMigrations.test.ts server/repositories/rosterRepository.test.ts server/services/roster/rosterImportService.test.ts src/domain/studentSorting.test.ts",
    "test:classroom": "node --import tsx --test server/repositories/classroomRepository.test.ts server/services/classroom/classroomWorkbook.test.ts",
    "test:schedule": "node --import tsx --test server/repositories/scheduleRepository.test.ts server/services/schedule/classEntityMatcher.test.ts server/services/schedule/scheduleImportService.test.ts server/services/schedule/reminderImportService.test.ts src/domain/scheduleTime.test.ts",
    "test:grading-roster": "node --import tsx --test src/domain/submissionRoster.test.ts",
    "test:grading-trial": "node --import tsx --test server/schemas/trialGrading.test.ts server/services/grading/OpenAICompatibleTrialGrader.test.ts server/services/grading/trialScore.test.ts server/services/grading/trialResultReconciler.test.ts src/domain/calibrationSamples.test.ts src/domain/gradingScoreDefaults.test.ts",
    "test:grading-analysis": "node --import tsx --test server/services/analysis/OpenAICompatibleQuestionAnalyzer.test.ts",
    "test:grading-intake": "node --import tsx --test server/repositories/materialRepository.test.ts server/services/materials/PaddleVisionMaterialParser.test.ts server/services/materials/sourcePageImage.test.ts",
    "test:vision-validation": "node --import tsx --test server/repositories/visionValidationRepository.test.ts server/services/materials/recognitionImagePreprocessor.test.ts server/services/grading/OpenAICompatibleVisionRecognizer.test.ts server/services/grading/OpenAICompatibleVisionRegionLocator.test.ts server/services/grading/FocusedPaddleRecognizer.test.ts server/services/grading/questionRegionCropper.test.ts server/services/grading/answerFieldSchema.test.ts server/services/evidence/sourceEvidenceResolver.test.ts",
    "test:resources": "node --import tsx --test server/repositories/resourceRepository.test.ts server/services/resources/resourceAnalyzer.test.ts",
    "migrate:roster-json": "node --import tsx server/scripts/migrateRosterJson.ts",
    "backup:roster": "node --import tsx server/scripts/backupRoster.ts",
    "backup:data": "node --import tsx server/scripts/backupAppData.ts",
    "verify:data": "node --import tsx server/scripts/verifyAppData.ts",
    "restore:data": "node --import tsx server/scripts/restoreAppData.ts",
    "test:operations": "node --import tsx --test server/config/runtimeConfig.test.ts server/services/operations/dataSnapshot.test.ts server/services/operations/productSnapshot.test.ts",
    "test:workspace-isolation": "node --import tsx --test server/context/workspaceIsolation.test.ts server/repositories/interruptedState.test.ts",
    "test:auth": "node --import tsx --test server/auth/authIntegration.test.ts",
    "auth:invite-owner": "node --import tsx server/scripts/bootstrapOwnerInvitation.ts",
    "migrate:legacy-workspace": "node --import tsx server/scripts/migrateLegacyWorkspace.ts",
    "backup:product": "node --import tsx server/scripts/backupProductData.ts",
    "verify:product": "node --import tsx server/scripts/verifyProductData.ts",
    "restore:product": "node --import tsx server/scripts/restoreProductData.ts",
    "backup:production": "node --import tsx server/scripts/backupProductionData.ts",
    "backfill:resource-ocr": "node --import tsx server/scripts/backfillResourceOcrArtifacts.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@google/genai": "^2.4.0",
    "@paddleocr/api-sdk": "^0.2.3",
    "@qdrant/js-client-rest": "1.18.0",
    "@xyflow/react": "^12.11.3",
    "better-auth": "1.7.3",
    "better-sqlite3": "12.11.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.546.0",
    "mem0ai": "3.3.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.54",
    "@types/express": "5.0.5",
    "@types/katex": "^0.16.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
