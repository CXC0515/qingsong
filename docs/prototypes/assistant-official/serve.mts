try{
 if(req.url===prefix+'/open'){if(!launchUrl){res.writeHead(503).end('官方界面启动中，请稍后刷新。');return;}const target=new URL(launchUrl);const cookies=await new Promise<string[]>((resolve,reject)=>{const r=httpRequest({hostname:'127.0.0.1',port:4482,path:'/'+target.search,headers:{host:'localhost:4480'}},incoming=>{incoming.resume();resolve(incoming.headers['set-cookie']??[]);});r.on('error',reject);r.end();});res.writeHead(303,{'set-cookie':cookies.map(cookiePath),location:prefix+'/'}).end();return;}
 const upstream=httpRequest({hostname:'127.0.0.1',port:4482,path:req.url.slice(prefix.length),method:req.method,headers:{...req.headers,host:'localhost:4480','accept-encoding':'identity'}},incoming=>{const headers=Object.fromEntries(Object.entries(incoming.headers).filter(([name])=>!['content-length','content-security-policy','x-frame-options','set-cookie'].includes(name)));if(incoming.headers['set-cookie'])headers['set-cookie']=incoming.headers['set-cookie'].map(cookiePath);
if(incoming.headers['content-type']?.includes('text/html')){let html='';incoming.setEncoding('utf8');incoming.on('data',chunk=>html+=chunk);incoming.on('end',async()=>{const css=await readFile(path.join(directory,'native-shell.css'),'utf8'),bridge=await readFile(path.join(directory,'native-bridge.js'),'utf8');res.writeHead(incoming.statusCode??200,headers).end(html.replace('</head>',`<style>${css}</style><script type="module">${bridge}</script></head>`));});}else{res.writeHead(incoming.statusCode??502,headers);incoming.pipe(res);}});upstream.on('error',()=>res.end());req.pipe(upstream);res.on('close',()=>upstream.destroy());
}catch{res.writeHead(502).end('原型连接未完成，请刷新。');}});
