[Unit]
Description=DEMO Teacher Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teacher-dashboard
Group=teacher-dashboard
WorkingDirectory=/opt/teacher-dashboard/current
EnvironmentFile=/etc/teacher-dashboard/teacher-dashboard.env
Environment="PATH=/opt/teacher-dashboard/runtimes/node-v24.22.1-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/teacher-dashboard/runtimes/node-v24.22.1-linux-x64/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teacher-dashboard

[Install]
WantedBy=multi-user.target
